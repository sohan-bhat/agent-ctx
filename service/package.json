{
  "name": "agent-ctx-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('public',{recursive:true})\" && wrangler dev --port 8790",
    "types": "node -e \"require('fs').mkdirSync('public',{recursive:true})\" && wrangler types --include-runtime=false --strict-vars=false",
    "test": "vitest run",
    "typecheck": "node -e \"require('fs').mkdirSync('public',{recursive:true})\" && wrangler types --include-runtime=false --strict-vars=false && tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.34.1",
    "fflate": "0.8.3",
    "hono": "4.13.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.2",
    "@cloudflare/workers-types": "5.20261125.1",
    "@modelcontextprotocol/client": "2.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.168.0"
  }
}
