{
  "description": "Sends prompts, edited paths, commands and the last reply to agent-ctx as the work happens. Every hook calls the event tool of the agent-ctx server.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-ctx:agent-ctx",
            "tool": "event",
            "timeout": 5,
            "input": { "host": "claude-code", "event": "UserPromptSubmit", "session": "${session_id}", "cwd": "${cwd}", "prompt": "${prompt}" }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-ctx:agent-ctx",
            "tool": "event",
            "timeout": 3,
            "input": { "host": "claude-code", "event": "PostToolUse", "session": "${session_id}", "cwd": "${cwd}", "tool": "${tool_name}", "file": "${tool_input.file_path}" }
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-ctx:agent-ctx",
            "tool": "event",
            "timeout": 3,
            "input": { "host": "claude-code", "event": "PostToolUse", "session": "${session_id}", "cwd": "${cwd}", "tool": "${tool_name}", "file": "${tool_input.notebook_path}" }
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-ctx:agent-ctx",
            "tool": "event",
            "timeout": 3,
            "input": { "host": "claude-code", "event": "PostToolUse", "session": "${session_id}", "cwd": "${cwd}", "tool": "${tool_name}", "command": "${tool_input.command}" }
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-ctx:agent-ctx",
            "tool": "event",
            "timeout": 3,
            "input": { "host": "claude-code", "event": "PostToolUseFailure", "session": "${session_id}", "cwd": "${cwd}", "tool": "${tool_name}", "command": "${tool_input.command}" }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-ctx:agent-ctx",
            "tool": "event",
            "timeout": 5,
            "input": { "host": "claude-code", "event": "Stop", "session": "${session_id}", "cwd": "${cwd}", "message": "${last_assistant_message}" }
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-ctx:agent-ctx",
            "tool": "event",
            "timeout": 5,
            "input": { "host": "claude-code", "event": "StopFailure", "session": "${session_id}", "cwd": "${cwd}", "reason": "${error}" }
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-ctx:agent-ctx",
            "tool": "event",
            "timeout": 5,
            "input": { "host": "claude-code", "event": "PostCompact", "session": "${session_id}", "cwd": "${cwd}", "summary": "${compact_summary}" }
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-ctx:agent-ctx",
            "tool": "event",
            "timeout": 5,
            "input": { "host": "claude-code", "event": "SessionStart", "session": "${session_id}", "cwd": "${cwd}", "source": "${source}" }
          }
        ]
      }
    ]
  }
}
