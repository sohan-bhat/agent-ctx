{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-ctx",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": { "MCP_RESOURCE": "http://localhost:8790/mcp" },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-oauth-kv" }],
  "ratelimits": [{ "name": "OPEN_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "PERSON", "class_name": "Person" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Person"] }],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/authorize", "/oauth/*", "/.well-known/*", "/login*", "/logout", "/api/*"]
  },
  "dev": { "port": 8790 },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "env": {
    "production": {
      "name": "agent-ctx",
      "vars": { "MCP_RESOURCE": "https://agent-ctx.invalid/mcp" },
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "replace-with-the-oauth-kv-namespace-id" }],
      "durable_objects": { "bindings": [{ "name": "PERSON", "class_name": "Person" }] },
      "ratelimits": [{ "name": "OPEN_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }]
    }
  }
}
